{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "globals": {
    "$derived": "readonly",
    "$effect": "readonly",
    "$state": "readonly",
    "DOMException": "readonly",
    "document": "readonly",
    "getComputedStyle": "readonly",
    "localStorage": "readonly",
    "navigator": "readonly",
    "process": "readonly",
    "URL": "readonly",
    "window": "readonly"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-undef": "error"
  }
}
